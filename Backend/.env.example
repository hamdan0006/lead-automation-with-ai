# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/leadsdb?schema=public"

# Redis Configuration (Used for BullMQ)
REDIS_URL="redis://localhost:6379"

# JWT Secret for Authentication (REQUIRED - Generate a strong random string)
JWT_SECRET="your_strong_random_secret_key_here_change_this"

# Gmail SMTP Configuration for Outreach
# Use a Gmail App Password, not your regular password
App_Pass="your_gmail_app_password_here"
SMTP_EMAIL="your_sender_email@gmail.com"

# Notification Email (Where you want to receive system alerts)
NOTIFICATION_EMAIL="your_admin_email@gmail.com"

# AI Model API Keys (OpenRouter recommended)
OPENAI_KEY="your_openrouter_openai_key"
Llama_KEY="your_openrouter_llama_key"
Nvidia_super3="your_openrouter_nvidia_key"

# SerpStack API Keys for Lead Enrichment
# You can add multiple keys for automatic rotation
SERPSTACK_API_KEY1="your_serpstack_key_1"
SERPSTACK_API_KEY2="your_serpstack_key_2"
SERPSTACK_API_KEY3="your_serpstack_key_3"
# ... add more as needed (up to SERPSTACK_API_KEY10)

# SerpStack Base URL
SERPSTACK_API_URL="https://api.serpstack.com/search"
