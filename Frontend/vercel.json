{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://51.21.219.214:3000/api/:path*"
    },
    {
      "source": "/scraper/:path*",
      "destination": "http://51.21.219.214:3000/api/scraper/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "http://51.21.219.214:3000/api/health/:path*"
